# Groq LLM provider
GROQ_API_KEY=
# Also supported: qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20

# Production CORS (Railway). Local Vite origins and the Vercel production
# host are always allowed. Override the preview regex if the project name changes.
# CORS_ORIGINS=https://<custom-domain>
# CORS_ORIGIN_REGEX=https://zomato-project.*\.vercel\.app
